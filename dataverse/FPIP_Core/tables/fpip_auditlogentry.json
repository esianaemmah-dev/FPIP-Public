    { "name": "fpip_action", "type": "string", "displayName": "Action", "maxLength": 300 },
    { "name": "fpip_entity_reference", "type": "string", "displayName": "Entity Reference", "maxLength": 300 },
    { "name": "fpip_source_detail", "type": "string", "displayName": "Source Detail", "maxLength": 300 }
  ],
  "lookups": [],
  "notes": "Populate from Dataverse built-in audit log via a scheduled export, OR write directly from every create/update. Phase 2: the agent service writes an entry on every tool call that reads sensitive data. Phase 3: Power Automate writes an entry (actor_type: Human) on every approval decision."
