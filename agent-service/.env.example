# --- Azure Key Vault (production path) ---
# In production, only this is required. The Container App's Managed Identity
# must have GET permission on the listed secret names.
AZURE_KEY_VAULT_URL=https://<your-kv>.vault.azure.net/

# --- Local-development fallbacks (never commit .env) ---
# Dataverse service principal (FPIP-Agent-Service app registration)
DATAVERSE_URL=https://<env>.crm.dynamics.com
DATAVERSE_TENANT_ID=
DATAVERSE_CLIENT_ID=
DATAVERSE_CLIENT_SECRET=

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT_NAME=fpip-gpt-4o
AZURE_OPENAI_API_VERSION=2024-06-01

# Azure AI Search
AZURE_SEARCH_ENDPOINT=https://<your-search>.search.windows.net
AZURE_SEARCH_KEY=

# Microsoft Fabric SQL analytics endpoint (bank-side OneLake)
FABRIC_CONNECTION_STRING=

# LangGraph conversation memory (Cosmos DB preferred; falls back to in-memory)
# Use the Cosmos DB account endpoint, e.g. https://<account>.documents.azure.com:443/
# Managed Identity on the Container App is used when no key is present.
COSMOS_DB_ENDPOINT=
COSMOS_DB_CONNECTION_STRING=
COSMOS_DB_DATABASE=fpip-agent-checkpoints
COSMOS_DB_CONTAINER=checkpoints

# FastAPI / CORS
APP_ENV=development
# Local development only. The service refuses AUTH_DISABLED=true when APP_ENV=production.
AUTH_DISABLED=true
AGENT_API_TENANT_ID=<your-tenant-id>
AGENT_API_AUDIENCE=api://<agent-service-client-id>
SUPPLIER_ID_CLAIM=extension_supplierId
ENTRA_GROUP_ROLE_MAP={"<group-object-id>":"procurement"}
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
