VITE_AGENT_SERVICE_URL=https://<your-agent-app>.<region>.azurecontainerapps.io
VITE_AGENT_API_SCOPE=api://<agent-service-client-id>/access_as_user
VITE_AAD_CLIENT_ID=<your-web-spa-client-id>
VITE_AAD_TENANT_ID=<your-tenant-id>
VITE_AAD_AUTHORITY=https://login.microsoftonline.com/<your-tenant-id>
VITE_DATAVERSE_URL=https://<your-org>.crm.dynamics.com
VITE_DATAVERSE_SCOPE=https://<your-org>.crm.dynamics.com/user_impersonation
VITE_SUPPLIER_AAD_CLIENT_ID=<your-supplier-spa-client-id>
VITE_SUPPLIER_AAD_AUTHORITY=https://login.microsoftonline.com/<your-tenant-id>
VITE_USE_DEMO_DATA=false
VITE_DISABLE_MS_AUTH=false
VITE_ENTRA_GROUP_MAP={"<admin-group-id>":"admin","<executive-group-id>":"executive","<procurement-group-id>":"procurement","<finance-group-id>":"finance","<auditor-group-id>":"auditor","<supplier-group-id>":"supplier"}
