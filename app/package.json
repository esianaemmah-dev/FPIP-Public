{
  "name": "fpip-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "FPIP — Finance & Procurement Intelligence Platform (Azure Managed Application). Phase 1 React UI scaffold: MSAL auth against Entra ID, Dataverse Web API data layer, and the five module views (Executive, Procurement, Finance, Supplier Portal, Governance & Audit).",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:swa": "npm run build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "@azure/msal-browser": "^3.14.0",
    "@azure/msal-react": "^2.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@types/node": "^20.14.15",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.3"
  }
}
