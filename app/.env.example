# --- FPIP Agent Service (Phase 2) ---
# Base URL of the LangGraph FastAPI service, e.g. https://fpip-agent-<hash>.azurecontainerapps.io
VITE_AGENT_SERVICE_URL=http://localhost:8000
# Delegated scope exposed by the FPIP-Agent-Service app registration.
VITE_AGENT_API_SCOPE=api://<agent-service-client-id>/access_as_user

# --- FPIP-Web-SPA (internal staff) Entra ID app registration ---
# Client (application) ID of the FPIP-Web-SPA app registration (see /entra/README.md).
VITE_AAD_CLIENT_ID=

# Tenant ID. Use "common" only if you support multiple banks; for a single
# customer tenant use that tenant's ID. For the Supplier Portal's external
# app registration use VITE_SUPPLIER_AAD_CLIENT_ID separately.
VITE_AAD_TENANT_ID=

# Full authority URL. For a single tenant: https://login.microsoftonline.com/<tenant-id>
# For external/guest scenarios, point the Supplier Portal build at the External ID authority.
VITE_AAD_AUTHORITY=https://login.microsoftonline.com/<tenant-id>

# --- Dataverse ---
# Base URL of the customer's Dataverse environment, e.g. https://contoso.crm.dynamics.com
VITE_DATAVERSE_URL=

# Scope requested for Dataverse access. Prefer:
#   https://<env>.crm.dynamics.com/user_impersonation
# (delegated SPA). Do not use /.default here — that is for confidential clients.
VITE_DATAVERSE_SCOPE=

# --- Supplier Portal (FPIP-Supplier-External) ---
# When building the Supplier Portal variant, set these to the external app reg.
VITE_SUPPLIER_AAD_CLIENT_ID=
VITE_SUPPLIER_AAD_AUTHORITY=

# --- Demo / no Microsoft auth ---
# true = seed data + no MSAL (use when authenticator / Entra not available).
VITE_USE_DEMO_DATA=true
VITE_DISABLE_MS_AUTH=true

# Optional: JSON map of Entra group Object ID → FPIP role
# VITE_ENTRA_GROUP_MAP={"abc123-def":"procurement","xyz789-ghi":"finance"}
